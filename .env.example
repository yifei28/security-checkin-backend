# Database Configuration
MYSQL_ROOT_PASSWORD=your-secure-password-here
MYSQL_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-secure-password-here

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
VERSION=latest

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here-minimum-256-bits

# Face Recognition Service (Optional)
FACE_SERVICE_URL=http://face-recognition:8000/recognize
FACE_SERVICE_PORT=8000
FACE_RECOGNITION_IMAGE=face-recognition:latest
FACE_SERVICE_BUILD_CONTEXT=/path/to/facial-recognition-service
FACE_SERVICE_MODELS_PATH=/path/to/facial-recognition-service/models

# Redis Configuration
REDIS_PORT=6379

# WeChat Mini Program Configuration (Production)
# Get these from https://mp.weixin.qq.com
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# JVM Options
JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

# Tomcat Configuration
TOMCAT_ACCEPT_COUNT=100
TOMCAT_MAX_THREADS=200